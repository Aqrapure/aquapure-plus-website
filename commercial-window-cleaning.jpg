:root{
  --navy:#082c63;
  --blue:#1976ff;
  --green:#69c93d;
  --ink:#13233a;
  --muted:#667085;
  --light:#f4f8fb;
  --white:#fff;
  --shadow:0 20px 60px rgba(8,44,99,.13);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial, Helvetica, sans-serif;color:var(--ink);background:var(--white);line-height:1.6}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.topbar{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:space-between;gap:24px;padding:12px 5vw;box-shadow:0 2px 20px rgba(8,44,99,.08)}
.brand img{width:210px;height:auto}.nav{display:flex;gap:24px;font-weight:700;color:var(--navy)}.nav a:hover{color:var(--blue)}.header-actions{display:flex;align-items:center;gap:12px}.phone-link{font-weight:800;color:var(--navy);white-space:nowrap}.btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:999px;background:var(--green);color:white;font-weight:800;padding:14px 22px;box-shadow:0 10px 25px rgba(105,201,61,.25);cursor:pointer}.btn:hover{transform:translateY(-1px)}.btn-small{padding:10px 16px;font-size:.9rem}.btn-outline{background:white;color:var(--navy);box-shadow:none}.btn-outline-green{background:#fff;color:var(--green);border:2px solid var(--green);box-shadow:none;margin-top:10px;width:100%}
.hero{position:relative;min-height:680px;background:url('/hero.jpg') center/cover no-repeat;display:flex;align-items:center;padding:80px 5vw;color:white}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,44,99,.92),rgba(8,44,99,.70),rgba(8,44,99,.20))}.hero-content{position:relative;max-width:760px}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:var(--green);font-weight:900;font-size:.82rem;margin:0 0 10px}.hero h1{font-size:clamp(2.6rem,7vw,5.8rem);line-height:.98;margin:0 0 20px}.hero-text{font-size:1.3rem;max-width:650px;margin-bottom:28px}.hero-buttons{display:flex;gap:14px;flex-wrap:wrap}.trust-strip{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.trust-strip span{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.25);padding:8px 12px;border-radius:999px;font-weight:700}
.section{padding:85px 5vw;max-width:1240px;margin:0 auto}.section-heading{text-align:center;max-width:760px;margin:0 auto 40px}.section h2,.reviews h2{color:var(--navy);font-size:clamp(2rem,4vw,3rem);line-height:1.1;margin:0 0 12px}.section-heading p{color:var(--muted);font-size:1.1rem}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.service-card{background:white;border-radius:24px;overflow:hidden;box-shadow:var(--shadow);border:1px solid #e7eef6}.service-card img{width:100%;height:220px;object-fit:cover}.service-card div{padding:24px}.service-card h3{margin:0 0 8px;color:var(--navy)}.service-card p{margin:0;color:var(--muted)}
.split-section{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;background:var(--light);max-width:none}.split-section>div:first-child{max-width:570px;margin-left:auto}.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;max-width:570px}.feature-grid div{background:white;padding:24px;border-radius:20px;box-shadow:0 10px 35px rgba(8,44,99,.08)}.feature-grid strong{display:block;color:var(--navy);font-size:1.2rem}.feature-grid span{color:var(--muted)}
.gallery-section{max-width:none;background:white}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1240px;margin:0 auto}.gallery-grid figure{margin:0;border-radius:22px;overflow:hidden;box-shadow:var(--shadow);background:white}.gallery-grid img{height:270px;width:100%;object-fit:cover}.gallery-grid figcaption{padding:14px 16px;font-weight:800;color:var(--navy)}.areas-section{background:var(--light);max-width:none}.area-list{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:900px;margin:0 auto}.area-list span{background:#fff;border:1px solid #dbe8f3;color:var(--navy);font-weight:800;padding:12px 18px;border-radius:999px}.reviews{text-align:center;background:var(--navy);color:white;max-width:none}.reviews h2{color:white}.stars{color:var(--green);font-size:2rem;margin:8px 0}.reviews blockquote{max-width:760px;margin:0 auto;font-size:1.25rem;font-style:italic}.small-note{opacity:.8;margin-top:18px}.contact-section{max-width:none;background:linear-gradient(135deg,#eef7ff,#f7fff3)}.contact-card{max-width:1180px;margin:0 auto;background:white;border-radius:30px;box-shadow:var(--shadow);padding:38px;display:grid;grid-template-columns:1fr 1fr;gap:40px}.contact-details{display:grid;gap:10px;margin-top:20px}.contact-details a{font-weight:800;color:var(--navy)}form{display:grid;gap:14px}label{display:grid;gap:6px;font-weight:800;color:var(--navy)}input,select,textarea{width:100%;border:1px solid #d7e3ee;border-radius:14px;padding:13px 14px;font:inherit;color:var(--ink);background:white}textarea{resize:vertical}.footer{background:#061f46;color:white;text-align:center;padding:50px 5vw}.footer img{width:230px;margin:0 auto 16px;background:white;border-radius:16px;padding:8px}.footer-links{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:18px}.footer-links a{font-weight:800}.floating-whatsapp{position:fixed;right:20px;bottom:20px;z-index:30;background:#25d366;color:white;font-weight:900;padding:14px 18px;border-radius:999px;box-shadow:0 16px 35px rgba(0,0,0,.22)}
@media(max-width:980px){.nav{display:none}.service-grid,.gallery-grid{grid-template-columns:repeat(2,1fr)}.split-section,.contact-card{grid-template-columns:1fr}.split-section>div:first-child{margin:0;max-width:none}.feature-grid{max-width:none}.header-actions .phone-link{display:none}}
@media(max-width:640px){.topbar{padding:10px 16px}.brand img{width:165px}.header-actions .btn{display:none}.hero{min-height:620px;padding:70px 20px}.hero-overlay{background:rgba(8,44,99,.78)}.hero h1{font-size:2.5rem}.service-grid,.gallery-grid,.feature-grid{grid-template-columns:1fr}.section{padding:62px 20px}.contact-card{padding:24px}.gallery-grid img,.service-card img{height:230px}.footer-links{display:grid}.floating-whatsapp{left:20px;right:20px;text-align:center}}
